{
  "name": "changelark",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "mkdir -p public/sdk && npm pack ./sdk/react-native --pack-destination public/sdk --silent && next build",
    "start": "next start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "check:backend": "node scripts/check-backend.mjs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:proofs": "node scripts/check-proofs.mjs",
    "check:selfhost": "node scripts/check-selfhost.mjs",
    "test": "node --test --no-warnings lib/*.test.ts scripts/*.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.5",
    "nodemailer": "10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright": "1.64.1",
    "supabase": "3.0.0",
    "typescript": "7.0.2"
  }
}
